# Application
NODE_ENV=development
PORT=3000

# Database (MongoDB)
# MONGO_URL is optional. Leaving it unset or blank keeps the current target:
# the shared MongoDB Atlas cluster, authenticated with DB_MONGO_PASSWORD.
# Set it to use the isolated local container instead (docker compose up -d):
# MONGO_URL=mongodb://localhost:27017/wavefit-perf
MONGO_URL=
DB_MONGO_PASSWORD=your-mongo-password

# Auth
JWT_SECRET=your-jwt-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4200/auth/callback

# Storage (AWS S3)
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name

# AI
PREFERRED_AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
AI_DAILY_LIMIT=10
AI_MAX_ATTEMPTS=3
AI_CALL_TIMEOUT_MS=45000
AI_TOTAL_BUDGET_MS=80000
AI_MAX_OUTPUT_TOKENS=5000

# Stats (AWS SQS)
STATS_SQS_QUEUE_URL=
